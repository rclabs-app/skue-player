# Template only: fill via the hosting secret manager; never commit a populated copy.
APP_NAME=Skue
APP_ENV=production
APP_DEBUG=false
APP_URL=https://backend-test.example.invalid
APP_KEY=
DB_CONNECTION=pgsql
# Set DB_URL from the isolated Neon database, including sslmode=require.
DB_URL=
DB_SSLMODE=require
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Exact emails of already created administrators; empty denies access outside local.
SKUE_ADMIN_EMAILS=
PORT=8080
